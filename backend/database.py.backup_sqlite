        # Lightweight migration: ensure sentiment and category columns exist
        cur.execute("PRAGMA table_info(processed_articles);")
        p_cols = [row[1] for row in cur.fetchall()]
        if "sentiment" not in p_cols:
            cur.execute("ALTER TABLE processed_articles ADD COLUMN sentiment TEXT;")
        if "category" not in p_cols:
