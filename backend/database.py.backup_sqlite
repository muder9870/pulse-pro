                    data.get("citations_count", 0),
                    json.dumps(data.get("authors", [])),
                    data.get("affiliations")
                )
            )
        else:
            cur.execute(
                """
                INSERT OR REPLACE INTO paper_analysis 
                (article_id, methodology, limitations, results, citations_count, authors, affiliations)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    article_id,
