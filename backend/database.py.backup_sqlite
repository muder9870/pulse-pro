def update_blog_post_content(blog_post_id: int, content: str, excerpt: str | None, focus_keyword: str | None) -> dict | None:
    init_db()
    content = (content or "").strip()
    if not content:
        raise ValueError("Content cannot be empty.")
    title = ""
    slug = ""
    with get_connection() as conn:
        cur = conn.cursor()
        cur.execute("SELECT title, slug FROM blog_posts WHERE id = ? LIMIT 1", (blog_post_id,))
        row = cur.fetchone()
        if row:
            title = str(row[0] or "")
            slug = str(row[1] or "")

    try:
        from backend.generators.seo_optimizer import optimize_markdown

        seo = optimize_markdown(title=title, md=content, base_slug=slug or title)
        content = seo.markdown
        meta_description = seo.meta_description
        readability_score = seo.readability_score
        platform_slugs = seo.platform_slugs_json
        alt_text_suggestions = seo.alt_text_suggestions_json
        if not focus_keyword:
            focus_keyword = seo.focus_keyword
    except Exception:
        meta_description = None
        readability_score = None
        platform_slugs = None
        alt_text_suggestions = None

    if excerpt is None or not str(excerpt).strip():
        s = (content or "").strip()
        s = re.sub(r"^#.*$", "", s, flags=re.MULTILINE).strip()
        s = re.sub(r"\n{2,}", "\n\n", s)
        first_para = s.split("\n\n", 1)[0].strip()
        first_para = re.sub(r"\s+", " ", first_para).strip()
        excerpt = first_para[:200].rstrip() if first_para else ""

    wc = len(re.findall(r"\b\w+\b", content or ""))
    rt = max(1, int(math.ceil(max(0, wc) / 200.0)))
    with get_connection() as conn:
        conn.row_factory = sqlite3.Row
        cur = conn.cursor()
        cur.execute(
            """
            UPDATE blog_posts
            SET
                content = ?,
                excerpt = ?,
                focus_keyword = ?,
                meta_description = COALESCE(?, meta_description),
                readability_score = COALESCE(?, readability_score),
                platform_slugs = COALESCE(?, platform_slugs),
                alt_text_suggestions = COALESCE(?, alt_text_suggestions),
                word_count = ?,
                reading_time = ?,
                updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
            """,
            (
                content,
                excerpt,
                focus_keyword,
                meta_description,
                readability_score,
                platform_slugs,
                alt_text_suggestions,
                wc,
                rt,
                blog_post_id,
            ),
        )
        conn.commit()
        cur.execute("SELECT * FROM blog_posts WHERE id = ? LIMIT 1", (blog_post_id,))
        row = cur.fetchone()
        return dict(row) if row else None


