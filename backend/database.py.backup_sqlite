    import json
    with get_connection() as conn:
        cur = conn.cursor()
        from backend.config import settings as _settings
        if "postgresql" in _settings.DATABASE_URL.lower():
            cur.execute(
                """
                INSERT INTO paper_analysis 
                (article_id, methodology, limitations, results, citations_count, authors, affiliations, analyzed_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)
                ON CONFLICT (article_id) DO UPDATE SET
                    methodology = EXCLUDED.methodology,
                    limitations = EXCLUDED.limitations,
                    results = EXCLUDED.results,
                    citations_count = EXCLUDED.citations_count,
                    authors = EXCLUDED.authors,
