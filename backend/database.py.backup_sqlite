def update_service_health(service_name: str, status: str, error: str | None = None, duration_ms: int = 0) -> None:
    """Update health status for a specific service and log to history."""
    init_db()
    with get_connection() as conn:
        cur = conn.cursor()
        
        # 1. Update system_status (current state)
        if status == "ok":
            cur.execute(
                """
                INSERT INTO system_status (service_name, status, last_run_at, success_count, failure_count, updated_at)
                VALUES (?, 'ok', CURRENT_TIMESTAMP, 1, 0, CURRENT_TIMESTAMP)
                ON CONFLICT(service_name) DO UPDATE SET
                    status = 'ok',
                    last_run_at = CURRENT_TIMESTAMP,
                    success_count = system_status.success_count + 1,
                    last_error = NULL,
                    updated_at = CURRENT_TIMESTAMP
                """,
                (service_name,),
            )
        else:
            cur.execute(
                """
                INSERT INTO system_status (service_name, status, last_run_at, success_count, failure_count, last_error, updated_at)
                VALUES (?, ?, CURRENT_TIMESTAMP, 0, 1, ?, CURRENT_TIMESTAMP)
                ON CONFLICT(service_name) DO UPDATE SET
                    status = excluded.status,
                    last_run_at = CURRENT_TIMESTAMP,
                    failure_count = system_status.failure_count + 1,
                    last_error = excluded.last_error,
                    updated_at = CURRENT_TIMESTAMP
                """,
                (service_name, status, error),
            )
            
        # 2. Log to health_history (persistent history)
        cur.execute(
            """
            INSERT INTO health_history (service_name, status, error_message, duration_ms, created_at)
            VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
            """,
            (service_name, status, error, duration_ms)
        )
        conn.commit()


def get_recent_failure_rate(service_name: str, window: int = 10) -> float:
    """Calculate the failure rate for a service over the last N runs."""
    with get_connection() as conn:
        cur = conn.cursor()
        cur.execute(
            """
            SELECT status FROM health_history 
            WHERE service_name = ? 
            ORDER BY created_at DESC 
            LIMIT ?
            """,
            (service_name, window)
        )
        rows = cur.fetchall()
        if not rows:
            return 0.0
        
        failures = sum(1 for row in rows if row[0] != 'ok')
        return failures / len(rows)


