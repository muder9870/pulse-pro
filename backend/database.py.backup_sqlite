        images = [dict(row) for row in cur.fetchall()]
        
        # Video Scripts
        cur.execute("""
            SELECT v.*, r.title as article_title, 'video_script' as asset_type
            FROM video_scripts v
            JOIN processed_articles p ON v.article_id = p.id
            JOIN raw_articles r ON p.raw_article_id = r.id
        """)
        scripts = [dict(row) for row in cur.fetchall()]
        
        assets = images + scripts
        assets.sort(key=lambda x: x.get('created_at', ''), reverse=True)
        return assets

