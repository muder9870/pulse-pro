DB_PATH: Path = settings.DB_PATH

# --- SQLAlchemy Support (Phase B) ---
engine = create_engine(
    settings.DATABASE_URL,
    # pool_size and max_overflow are only for Postgres/MySQL
    **(
        {"pool_size": 5, "max_overflow": 10, "pool_pre_ping": True, "pool_recycle": 1800}
        if "sqlite" not in settings.DATABASE_URL.lower()
        else {"pool_pre_ping": True}
    )
)
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)

@contextmanager
def get_session():
    """Context manager for SQLAlchemy sessions."""
    session = SessionLocal()
    try:
        yield session
        session.commit()
    except Exception:
        session.rollback()
        raise
    finally:
        session.close()

# --- Legacy SQLite Support ---
def init_db() -> None:
    """Create tables if they do not exist and apply simple migrations.

    This sets up only the core tables that everything else depends on.
    Additional tables (hashtags, blog, etc.) can be added incrementally.
    """
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)

    is_sqlite = "sqlite" in settings.DATABASE_URL.lower()
    if not is_sqlite:
        return # Skip legacy SQLite init for Postgres (managed by Alembic)

    with get_connection() as conn:
        cur = conn.cursor()
        
        if is_sqlite:
            # Enable WAL mode for better concurrency (SQLite only)
            cur.execute("PRAGMA journal_mode=WAL;")
            cur.execute("PRAGMA synchronous=NORMAL;")

        # raw_articles: ingested but not yet processed
        cur.execute(
            """
            CREATE TABLE IF NOT EXISTS raw_articles (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                url TEXT UNIQUE,
                source TEXT,
                category TEXT,
                raw_content TEXT,
                fetched_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                processed INTEGER DEFAULT 0
            );
            """
        )

        # Lightweight migration: ensure is_duplicate column exists
        cur.execute("PRAGMA table_info(raw_articles);")
        cols = [row[1] for row in cur.fetchall()]
        if "is_duplicate" not in cols:
            cur.execute("ALTER TABLE raw_articles ADD COLUMN is_duplicate INTEGER DEFAULT 0;")
        if "state" not in cols:
            # Article lifecycle state machine column.
            # Valid states: pending → analyzing → analyzed → skip | dead | archived
            cur.execute("ALTER TABLE raw_articles ADD COLUMN state TEXT DEFAULT 'pending';")
            # Backfill existing rows: processed=1 → 'analyzed', is_duplicate=1 → 'archived'
            cur.execute("UPDATE raw_articles SET state='analyzed' WHERE processed=1 AND (is_duplicate IS NULL OR is_duplicate=0);")
            cur.execute("UPDATE raw_articles SET state='archived' WHERE is_duplicate=1;")
        # Ensure index on state for fast worker selection
        cur.execute("CREATE INDEX IF NOT EXISTS idx_raw_articles_state ON raw_articles(state, fetched_at);")

        # processed_articles: summaries, scores, etc.
