    init_db()
    with get_connection() as conn:
        conn.row_factory = sqlite3.Row
        cur = conn.cursor()
        cur.execute(
            """
            SELECT id
            FROM generated_content
            WHERE article_id = ? AND platform = ?
            ORDER BY generated_at DESC, id DESC
            LIMIT 1
            """,
            (article_id, platform),
        )
        row = cur.fetchone()
        if not row:
            return None
        content_id = int(row["id"])

        if posted:
            cur.execute(
                "UPDATE generated_content SET posted = 1, posted_at = CURRENT_TIMESTAMP WHERE id = ?",
                (content_id,),
            )
            cur.execute(
                "INSERT INTO content_history (article_id, platform, action) VALUES (?, ?, ?)",
                (article_id, platform, "posted"),
            )
        else:
            cur.execute(
                "UPDATE generated_content SET posted = 0, posted_at = NULL WHERE id = ?",
                (content_id,),
            )
            cur.execute(
                "INSERT INTO content_history (article_id, platform, action) VALUES (?, ?, ?)",
                (article_id, platform, "unposted"),
            )

        conn.commit()

        cur.execute(
            """
            SELECT
                id,
                content,
                posted,
                posted_at,
                generated_at
            FROM generated_content
            WHERE id = ?
            """,
            (content_id,),
        )
        updated = cur.fetchone()
        return dict(updated) if updated else None


