# =============================================================================
# AI Pulse Pro — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Core (Required)
# -----------------------------------------------------------------------------
# Use a random 32+ character string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

DEBUG=false
DISABLE_SCHEDULER=0

# -----------------------------------------------------------------------------
# Database (Required for Docker)
# -----------------------------------------------------------------------------
POSTGRES_USER=pulseuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulsedb

# Full connection URL — auto-constructed from above in docker-compose.yml.
# Override here only if connecting to an external database.
# DATABASE_URL=postgresql+psycopg2://pulseuser:change-me@db:5432/pulsedb

# -----------------------------------------------------------------------------
# Redis (Required for Docker)
# -----------------------------------------------------------------------------
# Leave REDIS_PASSWORD empty to run Redis without authentication (local dev only).
# Set a password before exposing the app on any network.
REDIS_PASSWORD=change-me
# REDIS_URL is auto-constructed in docker-compose.yml from REDIS_PASSWORD.

# -----------------------------------------------------------------------------
# LLM Provider (Required — choose one)
# -----------------------------------------------------------------------------
# groq      -> Free API, fast, no GPU needed (RECOMMENDED)
# local     -> Ollama on localhost (needs real GPU)
# free_api  -> HuggingFace free inference
# paid_api  -> OpenAI or Anthropic
LLM_PROVIDER=groq

# Groq (free tier — get key at https://console.groq.com, no credit card needed)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local GPU)
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://127.0.0.1:11434

# OpenAI (paid)
OPENAI_API_KEY=sk-proj-
OPENAI_MODEL=gpt-4o-mini

# Anthropic (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Cerebras (free tier — fast inference)
# Get key at: https://cloud.cerebras.ai (free, no credit card)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# OpenRouter (pay-per-use, access to 200+ models including free ones)
# Get key at: https://openrouter.ai/keys (some models are free)
# Default model is free — change to a paid model for better quality
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Google Gemini (free tier — 30 RPM, 1000 requests/day)
# Get key at: https://aistudio.google.com (free, no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Mistral (free Experiment plan — ~1B tokens/month)
# Get key at: https://console.mistral.ai (free, phone verification required)
# Note: free tier requires opting into data training
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# HuggingFace (free tier — image generation)
# Get token at: https://huggingface.co/settings/tokens (free)
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
FREE_API_BASE_URL=

# Pollinations.ai (free with API key, get from enter.pollinations.ai)
# Used as last-resort fallback for text, image, and audio generation
# Set to false to disable
POLLINATIONS_TEXT_ENABLED=true
POLLINATIONS_API_KEY=sk_

# -----------------------------------------------------------------------------
# Pipeline Throughput
# -----------------------------------------------------------------------------
# Max articles fetched per source per pipeline run
INGEST_CAP_PER_SOURCE=50

# Max articles to analyze per pipeline run
ANALYSIS_LIMIT=10

# Max articles to generate content for per pipeline run
CONTENT_TOP_LIMIT=5

# Override for content generation limit (takes precedence over CONTENT_TOP_LIMIT)
GENERATION_TOP_N=5

# Platforms to generate content for (comma-separated)
CONTENT_PLATFORMS=twitter,linkedin,reddit,hackernews,medium

# Max pending articles before throttling ingestion
BACKLOG_THRESHOLD=200

# -----------------------------------------------------------------------------
# Data Sources (Optional — app works without these, uses arXiv + RSS by default)
# -----------------------------------------------------------------------------

# Gmail (IMAP newsletter fetching)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password at myaccount.google.com -> Security -> App Passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Gmail label to fetch newsletters from (case-sensitive, exact label name).
# The fetcher will read all emails from this label AND all its sub-labels.
# Example: if your label is "Pulse Pro" with sub-labels "Pulse Pro/The Batch" etc,
# set GMAIL_LABEL=Pulse Pro and all sub-labels are fetched automatically.
# Leave empty to fall back to searching by sender in INBOX.
GMAIL_LABEL=Pulse Pro

# GitHub (optional — increases rate limit from 10/min to 5000/hour)
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-pulse-pro/0.1

# -----------------------------------------------------------------------------
# Blog Publishing (Optional)
# -----------------------------------------------------------------------------
MEDIUM_API_KEY=
DEVTO_API_KEY=
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# -----------------------------------------------------------------------------
# Notifications (Optional)
# -----------------------------------------------------------------------------
# NOTIFY_ON: off | failure | success | always
NOTIFY_ON=failure

# Slack/Discord/custom webhook — expects a JSON POST body
NOTIFY_WEBHOOK_URL=

# Email notifications (requires all SMTP_* fields)
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Circuit Breaker (Advanced — defaults are fine for most setups)
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_THRESHOLD=0.75
CIRCUIT_BREAKER_WINDOW=50
CIRCUIT_BREAKER_COOLDOWN=120
